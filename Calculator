#include <iostream>

using namespace std;

int main() {
    float a, b;
    char c;
    
   
    cout << "Misalı daxil edin : ";
    cin >> a >> c >> b;
    
    cout << "Nəticə: ";
    
    switch (c) {
        case '+': 
            cout << a + b;
            break;
            
        case '-': 
            cout << a - b; // Səhv düzəldildi: << işlədildi
            break;
            
        case '*': 
            cout << a * b;
            break;
            
        case '/': 
            if (b != 0)
                cout << a / b;
            else
                cout << "Səhv: Sıfıra bölmək olmaz!";
            break;
            
        default: 
            cout << "this operation does not exist";
    }
    
    cout << endl;
    return 0;
}
