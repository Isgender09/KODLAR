#include <iostream>
#include <cmath> 

using namespace std;

int main() {
    float a, b, h, x, y;
    
    
    cout << "Enter a, b, and h: ";
    cin >> a >> b >> h;
    
    x = a;
    while (x <= b) {
        y = pow(x, 2);
        cout << x << "  " << y << endl;
        x += h;
    }
    
    return 0;
}
