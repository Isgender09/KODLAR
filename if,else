#include <iostream>
#include <cmath> 

using namespace std;

int main() {
    int a, x, y;
    
    cout << "a və x dəyərlərini daxil edin: ";
    cin >> a >> x; 
    
    if (a < 3) {
        y = pow(x, 2);
    }
    else if (a > 5) {
        y = pow(x, 3);
    }
    else {
        y = pow(x, 4);
    }
    
    cout << "y = " << y << endl;
    
    return 0;
}
